# labs — configuration
#
# Copy to .env and fill in. Everything the service reads is here; there is no
# config file. A value left out takes the default noted beside it.

# ── needed for the service to do anything ───────────────────────────────────
# Nothing here is fatal to start: a variable left out is reported by the log,
# /readyz and /api/v1/config, and the service runs but will not hand out a lab.
# The one exception is a variable set to an unreadable value (a duration that is
# not a duration), which stops the process.

# A GitHub token with Actions: write on every repository below. It is what the
# service dispatches the debugger workflows with.
LABS_GITHUB_TOKEN=

# The repositories the service may dispatch in, comma-separated, as owner/repo.
# An environment naming a repository outside this list is reported as a problem.
LABS_REPOS=shaowenchen/applab

# The environments, as JSON. Each entry is one long-lived, pre-warmed lab.
#
#   id         names the environment; its key variable is derived from it
#   kind       applab (sandboxlab is not implemented yet)
#   repo       the repository whose workflow brings it up; must be in LABS_REPOS
#   workflow   the workflow file to dispatch
#   ref        the git ref to dispatch on
#   domain     the bare hostname the environment is served under — this is what
#              the service polls, so it must be stable across runs, which is
#              what a *named* Cloudflare tunnel gives
#   base_path  the path the deployment is served under, e.g. /applab
#   slots      the app ids the environment lends out, one per session (applab)
#   capacity   how many concurrent sessions it may serve (= len(slots) for applab)
#   inputs     optional extra workflow_dispatch inputs, merged over the defaults
#              (session_hours, tunnel=cloudflare, domain)
LABS_ENVIRONMENTS=[{"id":"applab-1","kind":"applab","repo":"shaowenchen/applab","workflow":"debugger.yml","ref":"main","domain":"applab-1.example.com","base_path":"/applab","slots":["lab-01","lab-02","lab-03","lab-04"],"capacity":4}]

# The key each environment is configured with — the same value you set as the
# APPLAB_API_KEY secret in the applab repository. The variable name is
# LABS_KEY_<ID> uppercased, non-alphanumerics replaced with "_": applab-1
# becomes LABS_KEY_APPLAB_1.
#
# This is the admin key: the service uses it to rotate the per-session app key a
# caller receives. It never reaches a caller, and a run dispatched without an
# api_key input falls through to the repository secret, so this value does not
# appear in any dispatch payload.
LABS_KEY_APPLAB_1=

# ── optional ────────────────────────────────────────────────────────────────

# Where the service listens. Non-root cannot bind a port below 1024. When this
# is unset the service honours PORT (what a container platform injects and then
# probes), and falls back to :8080.
#LABS_LISTEN=:8080

# How long a delivered lab lasts. This is the product's promise.
#LABS_SESSION_TTL=2h

# How often expired sessions are collected, and how often reconciliation runs
# (the latter every 20 sweeps).
#LABS_REAP_INTERVAL=30s

#debug, info, warn, error.
#LABS_LOG_LEVEL=info

# The REST base. Point it at a GitHub Enterprise host if that is where the
# repositories live.
#LABS_GITHUB_API=https://api.github.com

# The ref workflows are dispatched on, and the session_hours input passed to
# them. The workflows declare session_hours as a choice, so it must be one of
# 1, 2, 4 or unlimited — 4 gives a four-hour run with a 280-minute job timeout.
#LABS_DISPATCH_REF=main
#LABS_DISPATCH_SESSION_HOURS=4

# Keep environments warm by dispatching successor runs before the current one
# ends. Off means an environment is only used if something else started it —
# there is no on-demand start yet, so a deployment without the keeper needs a
# warm run from elsewhere.
#LABS_KEEPWARM=true
#LABS_KEEPWARM_INTERVAL=60s

# How long before a run's expected end its successor is queued. Must be shorter
# than the boot time (about ten minutes) by enough to overlap it.
#LABS_REDISPATCH_MARGIN=45m

# Limits. LABS_MAX_SESSIONS=0 derives the ceiling from the environments'
# capacities. The per-address session cap is what stops one caller from taking
# the whole deployment; the rate limit is a fixed window on POST /api/v1/labs.
#LABS_MAX_SESSIONS=0
#LABS_MAX_SESSIONS_PER_IP=1
#LABS_RATE_LIMIT_COUNT=5
#LABS_RATE_LIMIT_WINDOW=1h

# Believe X-Forwarded-For for the client address. Only set this when the service
# sits behind a proxy that sets it AND the service's own port is not reachable
# directly — otherwise every limit is bypassable with a header. The compose file
# sets it true because only Caddy can reach the service there.
#LABS_TRUSTED_PROXY=false
