# labs — configuration
#
# Copy to .env and fill in. Everything the service reads is here; there is no
# config file. A value left out takes the default noted beside it.

# ── this is the whole configuration ─────────────────────────────────────────

# A GitHub token with Actions: read and write on the repositories below. That is
# the only variable a default deployment needs.
GITHUB_TOKEN=

# The repositories the service runs, one variable per kind, each a
# comma-separated list of owner/repo. One entry is one environment — there is no
# separate environment list to write.
#
# They are separate on purpose. A single list covering both kinds was the
# earlier shape, and setting it to one repository silently dropped the other
# kind: a deployment that looked configured was serving half of what it should.
# With one variable each, configuring applab can never hide sandboxlab.
#
# Which variable a repository comes from is what decides its kind — not its
# name. So a fork called something else still runs as the project it belongs to.
#
#   LABS_APPLAB_REPOS      applab environments, served under /applab
#   LABS_SANDBOXLAB_REPOS  sandboxlab environments, served under /sandboxlab
#
# Leave one unset to take its default (shaowenchen/applab, or
# shaowenchen/sandboxlab). Set it to empty to turn that kind off on purpose.
#
# Everything else is derived: the served path, the workflow (debugger.yml for
# both), and the address. The key is the one thing that is not — see
# ADMIN_KEY below.
#LABS_APPLAB_REPOS=shaowenchen/applab
#LABS_SANDBOXLAB_REPOS=shaowenchen/sandboxlab

# The key labs calls every environment with, and therefore the key they are
# brought up holding. One value for applab and sandboxlab alike.
#
# Optional. Leave it out and the service generates a random one at startup. Set
# it and that value is used as it is.
#
# There is no built-in default — a constant string compiled into the service was
# what this used to fall back to, and a key checked into a repository is not a
# secret: anyone who could read it could call any deployment that had not set
# one, and every such deployment answered to the same value.
#
# What a generated key costs is reach. Both sides of a dispatch read the key
# from the same place, so a lab labs starts always matches — but a key that is
# random per process cannot reach an environment an earlier process brought up,
# nor one started by hand. Set it — and set each repository's own secret to the
# same value — to reach any environment that was brought up holding it, including
# one already running. For sandboxlab the repository secret has this same name,
# ADMIN_KEY; for applab it is APPLAB_API_KEY.
#
# The two halves are a pair: this one is what labs sends at dispatch, the
# repository's secret is what the workflow falls back to, and a value in only
# one place leaves the environment reachable by only one side.
#
# A workflow that has not declared the api_key input rejects the dispatch
# outright — GitHub answers 422 and no run starts — so if a kind refuses to
# start, that input is the thing to check first.
#ADMIN_KEY=

# ── the address (optional) ──────────────────────────────────────────────────
# Each kind has a default: applab-1.chenshaowen.com for an applab environment and
# sandboxlab-1.chenshaowen.com for a sandboxlab one. Both are hostnames the
# project's own debugger workflow declares, so the dispatch accepts them, and a
# named tunnel is expected to serve them. Set nothing and the service uses those.
#
# Override when your tunnel serves a different hostname. LABS_DOMAIN_SUFFIX is a
# bare suffix: a repository named applab is then served at applab.<suffix>.
#
# A named Cloudflare tunnel is required either way — it is what keeps the
# hostname stable across runs. A quick tunnel is assigned a new one each time and
# the service could not follow it.
#LABS_DOMAIN_SUFFIX=example.com

# ── per-environment overrides (optional) ────────────────────────────────────
# Both are named for the repository with its name uppercased: for
# shaowenchen/applab that is APPLAB.
#
#   LABS_DOMAIN_APPLAB   this environment's exact hostname, instead of the
#                        suffix or the default
#   LABS_KEY_APPLAB      use this key for this one environment instead of
#                        ADMIN_KEY
#LABS_DOMAIN_APPLAB=
#LABS_KEY_APPLAB=

# For a sandboxlab repository (LABS_SANDBOXLAB_REPOS=shaowenchen/sandboxlab), the
# variables use the name SANDBOXLAB. Two things are specific to it:
#
#   LABS_DOMAIN_SANDBOXLAB changes the address from its default. sandboxlab's
#                          domain input is a choice — only
#                          sandboxlab-1.chenshaowen.com and
#                          sandboxlab-2.chenshaowen.com are accepted — and the
#                          default is the first of those, so set this only if
#                          your tunnel serves the second.
#   LABS_TEMPLATE_SANDBOXLAB is the template a sandbox is created from. Left out,
#                          the catalog's first template is used.
#
# Its key is the same ADMIN_KEY, sent in the dispatch like applab's. sandboxlab's
# own secret happens to carry that name too, so the same value is set in both
# places — labs reads it here, the debugger workflow falls back to it there when
# a dispatch carries no api_key.
#LABS_DOMAIN_SANDBOXLAB=sandboxlab-1.chenshaowen.com
#LABS_BASE_PATH_SANDBOXLAB=/sandboxlab
#LABS_KEY_SANDBOXLAB=
#LABS_TEMPLATE_SANDBOXLAB=all-in-one

# ── optional ────────────────────────────────────────────────────────────────

# Where the service listens. Non-root cannot bind a port below 1024. When this
# is unset the service honours PORT (what a container platform injects and then
# probes), and falls back to :8080.
#LABS_LISTEN=:8080

# How long a delivered lab lasts. This is the product's promise.
#LABS_SESSION_TTL=2h

# How often expired sessions are collected, and how often reconciliation runs
# (the latter every 20 sweeps).
#LABS_REAP_INTERVAL=30s

#debug, info, warn, error.
#LABS_LOG_LEVEL=info

# The REST base. Point it at a GitHub Enterprise host if that is where the
# repositories live.
#LABS_GITHUB_API=https://api.github.com

# The ref workflows are dispatched on. Leave this out and each repository's own
# default branch is used, which is what you want: the two projects publish from
# master and from main, and a hardcoded ref dispatches one that does not exist on
# the other — a 404 that produces no run at all.
#LABS_DISPATCH_REF=

# The session_hours input passed to the workflow. It declares this as a choice,
# so it must be one of 1, 2, 4 or unlimited — 4 gives a four-hour run with a
# 280-minute job timeout. This is how long the cluster is kept before it is
# replaced.
#LABS_DISPATCH_SESSION_HOURS=4

# How many application slots one cluster offers at once, which is how many labs
# can be in use across every cluster. Each slot is a running app, so raising it
# raises what the cluster carries. applab only; sandboxlab counts sandboxes.
#LABS_ENV_SLOTS=8

# There is no warm-up to configure. A repository runs one environment at a time
# (its workflow's concurrency group allows a single run), so an environment is
# checked for and, only if not already running, started — at the moment a lab is
# created. An environment already up, whoever started it, is used as it is.

# Limits. LABS_MAX_SESSIONS=0 derives the ceiling from the environments'
# capacities. The per-address session cap is what stops one caller from taking
# the whole deployment; the rate limit is a fixed window on POST /api/v1/labs.
#LABS_MAX_SESSIONS=0
#LABS_MAX_SESSIONS_PER_IP=1
#LABS_RATE_LIMIT_COUNT=5
#LABS_RATE_LIMIT_WINDOW=1h

# Believe X-Forwarded-For for the client address. Only set this when the service
# sits behind a proxy that sets it AND the service's own port is not reachable
# directly — otherwise every limit is bypassable with a header. The compose file
# sets it true because only Caddy can reach the service there.
#LABS_TRUSTED_PROXY=false
